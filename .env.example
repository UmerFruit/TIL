# Path to the SQLite file (default: data/til.db at the repo root)
DB_PATH=
# Port
PORT=3000
# Required: login password
APP_PASSWORD=
# Required: at least 32 characters, signs the session cookie
SESSION_SECRET=
# Set to "true" in production (HTTPS); leave empty in dev
COOKIE_SECURE=
# Docker socket used to start sandbox sessions (default: /var/run/docker.sock)
DOCKER_SOCKET=
# Sandbox session limits
SANDBOX_MEMORY_MB=1024
SANDBOX_CPUS=1
SANDBOX_PIDS=256
SANDBOX_IDLE_MINUTES=120
