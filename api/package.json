        "better-sqlite3": "^13.2.0",
        "dockerode": "5.0.1",
        "hono": "^4.13.16",
        "marked": "12.0.2",
        "tar-stream": "3.2.2",
        "yaml": "^2.9.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/dockerode": "4.0.2",
        "@types/node": "^26.1.1",
        "@types/tar-stream": "3.1.5",
        "tsx": "^4.23.0",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
